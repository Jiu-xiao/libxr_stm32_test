# 让 Git 识别文本并在仓库内规范化为 LF
* text=auto

# 强制某些文件始终使用 LF（常见脚本/配置）
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.js   text eol=lf

# Windows 批处理/脚本需要 CRLF 的例外
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 明确二进制（避免被当作文本改行尾）
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
